# Copy to deploy/production.env on the server; preflight sources this trusted operator file.
PA_DOMAIN='research.example.com'
PA_ADMIN_USER='operator'
# Generate with: docker run --rm caddy:2.11.4-alpine caddy hash-password --plaintext '...'
PA_ADMIN_PASSWORD_HASH=''
# Keep the directory root-owned mode 700 and files root-owned mode 400/440; Compose mounts them read-only only into authorized services.
PA_DATABASE_URL_SECRET_FILE='/srv/pocket-alpha/secrets/database_url'
PA_REDIS_URL_SECRET_FILE='/srv/pocket-alpha/secrets/redis_url'
PA_POSTGRES_PASSWORD_SECRET_FILE='/srv/pocket-alpha/secrets/postgres_password'
PA_REDIS_PASSWORD_SECRET_FILE='/srv/pocket-alpha/secrets/redis_password'
